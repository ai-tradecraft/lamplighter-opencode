{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tradecraft.local/schemas/lamplighter/agent_session_spec.schema.json",
  "title": "AgentSessionSpec",
  "type": "object",
  "additionalProperties": false,
  "required": ["agent_session_id", "workspace_ref", "context_package", "backend"],
  "properties": {
    "agent_session_id": {
      "type": "string",
      "minLength": 1
    },
    "goal_run_id": {
      "type": ["string", "null"]
    },
    "phase_run_id": {
      "type": ["string", "null"]
    },
    "agent_definition_id": {
      "type": ["string", "null"]
    },
    "resolved_agent_profile_id": {
      "type": ["string", "null"]
    },
    "workspace_ref": {
      "type": "string",
      "minLength": 1
    },
    "repo_ref": {
      "type": ["string", "null"]
    },
    "base_revision": {
      "type": ["string", "null"]
    },
    "branch_name": {
      "type": ["string", "null"]
    },
    "context_package": {
      "type": "object"
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_kind", "model", "base_url_env_var", "api_key_env_var"],
      "properties": {
        "provider_kind": {
          "const": "microsoft_foundry"
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "base_url_env_var": {
          "type": "string",
          "minLength": 1
        },
        "api_key_env_var": {
          "type": "string",
          "minLength": 1
        },
        "wire_api": {
          "const": "responses",
          "default": "responses"
        }
      }
    },
    "tool_profile": {
      "type": "object"
    },
    "mcp_profile": {
      "type": "object"
    },
    "artifact_contract": {
      "type": "object"
    },
    "timeout_policy": {
      "type": "object"
    },
    "telemetry": {
      "type": "object"
    }
  }
}
