# ChatThroughHarness React client local environment
#
# Copy to `.env.local` or `.env` in this folder for Vite. Values must be
# prefixed with VITE_ to be exposed to browser code.

# API base URL. Leave empty when Vite proxies/serves from the same origin.
# For the default standalone API run, use http://127.0.0.1:5087.
VITE_API_BASE_URL=http://127.0.0.1:5087
