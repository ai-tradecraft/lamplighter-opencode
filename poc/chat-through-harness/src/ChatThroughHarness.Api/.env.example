# ChatThroughHarness.Api local environment
#
# ASP.NET does not load this file automatically. Use it as a shell reference,
# or source/export the values before running `dotnet run`.

# HTTP binding for the API. If unset, the POC defaults to http://127.0.0.1:5087.
ASPNETCORE_URLS=http://127.0.0.1:5087

# Legacy harness mode switch retained for comparison/debug paths.
# fake: deterministic in-process fake harness.
# cli: direct CLI adapter path. The current runner workflow uses queued commands.
CHAT_HARNESS_MODE=fake

# Optional ASP.NET environment name for logging/config conventions.
ASPNETCORE_ENVIRONMENT=Development

# Optional runtime storage override. The default is the POC's .agent-runtime
# folder. Tests set this to an isolated temporary folder.
CHAT_THROUGH_HARNESS_RUNTIME_ROOT=.agent-runtime

# Central directory for API, runner, UI, browser, harness, and OpenCode logs.
# The tmux launcher defaults this to .agent-runtime/logs.
CHAT_THROUGH_HARNESS_LOG_ROOT=.agent-runtime/logs
