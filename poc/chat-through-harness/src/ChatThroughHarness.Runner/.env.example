# ChatThroughHarness.Runner local environment
#
# ASP.NET/.NET Generic Host does not load this file automatically. Use it as a
# shell reference, or source/export the values before running `dotnet run`.
# Nested .NET configuration keys use double underscores in environment vars.

# Stable id for this local runner as seen by the orchestrator/API.
Runner__RunnerId=runner_local

# Tradecraft Orchestrator / POC API base URI.
Runner__OrchestratorBaseUri=http://127.0.0.1:5087

# How often the runner checks for queued commands when no long poll is active.
Runner__PollInterval=00:00:02

# Maximum wait time for one long-poll command request.
Runner__LongPollWait=00:00:30

# How often the runner reports local agent inventory to the API.
Runner__HeartbeatInterval=00:00:10

# Lease duration when the runner claims a command.
Runner__LeaseSeconds=60

# Backoff after command loop failures.
Runner__RetryBackoff=00:00:05

# Optional controller-owned storage root. When omitted, Lamplighter uses the
# platform data directory documented in the project README.
LAMPLIGHTER_CONTROLLER_WORKSPACE=

# Optional central component-log override. The launcher defaults this to the
# controller workspace's logs directory.
CHAT_THROUGH_HARNESS_LOG_ROOT=

# Optional absolute path to the lamplighter-opencode repo root. Leave empty for
# auto-discovery from the runner build output.
Runner__HarnessRepoRoot=

# OpenCode/Lamplighter backend controls forwarded to the CLI process.
# Provider, model, and auth configuration belongs to OpenCode itself. Configure
# OpenCode before enabling the real backend; do not place provider secrets here.
LAMPLIGHTER_OPENCODE_USE_REAL_BACKEND=0
