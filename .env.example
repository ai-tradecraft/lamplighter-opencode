# Lamplighter for OpenCode local environment
#
# Copy to `.env` for local development only. Do not commit `.env`.
# Production runners should receive these values from the deployment platform
# or secret provider, not from a checked-in file.

# Set to 1 to allow tests and CLI calls to hit a real OpenCode backend.
# Leave as 0 or unset for deterministic fake responses.
LAMPLIGHTER_OPENCODE_USE_REAL_BACKEND=0

# Controls how OpenCode configuration is resolved.
# inherit-global: default local mode; uses the user's global OpenCode config.
# project-only: isolated session-local OpenCode config for deterministic tests.
# managed: reserved for production-style injected configuration.
LAMPLIGHTER_OPENCODE_CONFIG_MODE=inherit-global

# Optional model override used when inheriting global OpenCode configuration.
# If unset, OpenCode's global default is used unless AZURE_OPENAI_DEPLOYMENT is set.
LAMPLIGHTER_OPENCODE_MODEL=

# Azure OpenAI / Microsoft Foundry values used by project-only real-backend tests.
# Required when LAMPLIGHTER_OPENCODE_USE_REAL_BACKEND=1 and
# LAMPLIGHTER_OPENCODE_CONFIG_MODE=project-only.
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=your-deployment-name
AZURE_OPENAI_API_KEY=replace-with-local-secret

# Optional. Usually inferred from AZURE_OPENAI_ENDPOINT.
AZURE_OPENAI_RESOURCE_NAME=
